<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jiangsu.tender-monitor.auto-refresh</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>__RUNTIME_DIR__/scripts/run-auto-refresh.sh</string>
  </array>
  <!-- launchd 不会读取终端里的 export；请替换为你自己的 SCT SendKey。 -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>SERVERCHAN_SENDKEY</key>
    <string>SCT-REPLACE-ME</string>
  </dict>
  <!-- 全天每 1 小时触发一轮（3600 秒）。 -->
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>StandardOutPath</key>
  <string>__RUNTIME_DIR__/data/auto-refresh.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__RUNTIME_DIR__/data/auto-refresh.stderr.log</string>
</dict>
</plist>
