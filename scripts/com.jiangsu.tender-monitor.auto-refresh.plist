<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jiangsu.tender-monitor.auto-refresh</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>__RUNTIME_DIR__/scripts/run-auto-refresh.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>StandardOutPath</key>
  <string>__RUNTIME_DIR__/data/auto-refresh.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__RUNTIME_DIR__/data/auto-refresh.stderr.log</string>
</dict>
</plist>
